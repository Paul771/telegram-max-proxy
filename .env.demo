# Demo configuration for testing
# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz-DEMO-TOKEN
TELEGRAM_WEBHOOK_PATH=/webhook/telegram

# MAX Messenger API
MAX_API_BASE_URL=https://platform-api.max.ru
MAX_API_TOKEN=demo_max_token_12345_for_testing
MAX_TIMEOUT=30

# Режим работы с MAX API: webhook или polling
MAX_MODE=webhook

# Маппинг чатов (JSON формат)
CHAT_USER_MAPPING={"123456789": "987654321", "111111111": "222222222"}

# Proxy settings
HOST=127.0.0.1
PORT=8000

# Уровень логирования: debug, info, warning, error
LOG_LEVEL=info
