# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_PATH=/webhook/telegram

# MAX Messenger API
# Базовый URL MAX API (по умолчанию https://platform-api.max.ru)
# MAX_API_BASE_URL=https://platform-api.max.ru
MAX_API_TOKEN=your_max_bot_token_here

# MAX API timeout (секунды)
# MAX_TIMEOUT=30

# Режим работы с MAX API: webhook или polling
# MAX_MODE=webhook

# Маппинг чатов (JSON формат)
# Сопоставление Telegram chat_id с MAX user_id
# Формат: {"telegram_chat_id": "max_user_id", ...}
# Пример: CHAT_USER_MAPPING={"123456789": "987654321", "111222333": "444555666"}
# ВАЖНО: Telegram chat_id - это числовой ID чата, MAX user_id - это числовой ID пользователя в MAX
CHAT_USER_MAPPING={}

# Proxy settings
HOST=0.0.0.0
PORT=8000

# HTTP/SOCKS Proxy для доступа к Telegram API (если Telegram заблокирован)
# HTTP прокси: HTTP_PROXY=http://proxy.example.com:8080
# SOCKS5 прокси: SOCKS_PROXY=socks5://127.0.0.1:1080
# HTTP_PROXY=
# SOCKS_PROXY=

# MTProto Proxy для Telegram API (рекомендуется для обхода блокировок)
# Получите MTProto прокси на https://t.me/proxy или https://mtproto.co
# MTPROTO_PROXY_HOST=proxy.example.com
# MTPROTO_PROXY_PORT=443
# MTPROTO_PROXY_SECRET=dd1234567890abcdef1234567890abcdef

# Уровень логирования: debug, info, warning, error
LOG_LEVEL=info
