# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_PATH=/webhook/telegram

# MAX Messenger API
# Базовый URL MAX API (по умолчанию https://api.max.ru/bot)
# MAX_API_BASE_URL=https://api.max.ru/bot
MAX_API_TOKEN=your_max_bot_token_here

# MAX API endpoints (значения по умолчанию)
# MAX_SEND_ENDPOINT=/messages/send
# MAX_RECEIVE_ENDPOINT=/updates/get
# MAX_TIMEOUT=30

# Режим работы с MAX API: webhook или polling
# MAX_MODE=webhook

# Маппинг чатов (JSON формат)
# Сопоставление Telegram chat_id с MAX user_id
# CHAT_USER_MAPPING={"123456789": "max_user_1", "987654321": "max_user_2"}

# Proxy settings
HOST=0.0.0.0
PORT=8000

# Уровень логирования: debug, info, warning, error
LOG_LEVEL=info
